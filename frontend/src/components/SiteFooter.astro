---
import type { Lang } from '../data/site';
import { site, logos } from '../data/site';
import { icons } from '../data/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = site[lang];
const currentYear = new Date().getFullYear();

const socialSvgs: Record<string, string> = {
  linkedin:
    'M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z',
  facebook:
    'M15.4024 21V14.0344H17.7347L18.0838 11.3265H15.4024V9.59765C15.4024 8.81364 15.62 8.27934 16.7443 8.27934L18.1783 8.27867V5.85676C17.9302 5.82382 17.0791 5.75006 16.0888 5.75006C14.0213 5.75006 12.606 7.01198 12.606 9.32952V11.3265H10.2677V14.0344H12.606V21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3H20C20.5523 3 21 3.44772 21 4V20C21 20.5523 20.5523 21 20 21H15.4024Z',
};

---

<footer id="site-footer" class="sticky bottom-0 left-0 mt-auto w-full shrink-0 max-phablet:relative">
  <div class="flex flex-col items-center bg-white px-m py-section-xs">
    <div class="flex w-content max-w-full flex-col items-center gap-y-l max-phablet:items-start">
      <a class="inline-block h-fit w-[10em]" href={t.homeUrl}>
        <img class="h-auto w-full" src={logos.dark} alt={t.logoAlt} width="464" height="292" loading="lazy" />
      </a>

      <nav class="w-mid max-w-full" aria-label={t.footerAria}>
        <ul class="m-0 flex list-none flex-row flex-wrap items-center justify-center gap-m p-0 max-phablet:justify-start">
          {
            t.footerNav.map((item) => (
              <li class="w-auto">
                <a class="underline underline-offset-[0.25em]" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="m-0 flex list-none flex-wrap items-center gap-x-[1em] pl-0 max-tablet:gap-y-[1em]">
        {
          t.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="flex no-underline">
              <svg
                class="size-[1.5em] fill-primary text-primary-dark"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={s.icon === 'instagram' ? icons.instagramSmall.d : socialSvgs[s.icon]} />
              </svg>
              <span class="sr-only">{s.label}</span>
            </a>
          ))
        }
      </div>

      <div class="flex flex-col flex-wrap items-center justify-center gap-x-m gap-y-[0.5em] text-m">
        <p class="m-0 max-phablet:mb-[0.2em]">© 2025 - <span data-current-year>{currentYear}</span> jmc.</p>
        <nav class="flex w-auto flex-row max-phablet:items-start" aria-label={t.legalAria}>
          <ul class="m-0 flex list-none flex-nowrap justify-center gap-[1em] pl-0">
            {
              t.legalLinks.map((item) => (
                <li class="w-auto">
                  <a class="underline underline-offset-[0.25em]" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script>
  // Aktualisiert auch einen statischen Build beim Seitenaufruf im neuen Jahr.
  document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((element) => {
    element.textContent = String(new Date().getFullYear());
  });
</script>
