---
/**
 * Blogübersicht und Kategorie-Archive (DE/EN).
 */
import type { Lang } from '../data/site';
import PostCardEcho from './PostCardEcho.astro';
import type { CardData } from './PostCardEcho.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';

interface Props {
  lang: Lang;
  variant: 'blog' | 'category';
  /** Überschrift + Label + Einleitungstext (Blog bzw. Kategorie) */
  heading: string;
  accent: string;
  paragraphs: string[];
  cards: CardData[];
}

const { variant, heading, accent, paragraphs, cards } = Astro.props;
---

<Section>
  <Container class="gap-y-[calc(var(--spacing-m)/2)]">
    <h1>{heading}</h1>
    <div class="order-first text-m leading-[1.1]">{accent}</div>
  </Container>

  <Container>
    <div class="w-full gap-x-m [column-count:2] [column-width:30ch] [&_p]:m-0 [&_p+p]:mt-[1em]">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </Container>

  <Container
    as="ul"
    layout="grid"
    class="m-0 grid-cols-(--columns-cards) grid-rows-1 items-stretch gap-m pl-0"
  >
    {cards.map((card) => <PostCardEcho card={card} withFooter={variant === 'category'} />)}
  </Container>
</Section>
