Options -Indexes
DirectoryIndex index.html

# Sitemaps (@astrojs/sitemap: sitemap-index.xml and sitemap-0.xml, ...):
# browsers (Accept contains text/html) get the readable static HTML twin of the
# XML file, without redirect, so the URL stays *.xml and no browser XSLT is
# needed. Crawlers and other clients (Accept: application/xml or */*) keep
# receiving the plain standards-compliant XML. Vary tells caches that the
# response depends on Accept.
#
# The HTML twins get their Content-Type forced explicitly. LiteSpeed otherwise
# sometimes keeps the MIME type it cached for the *.xml URL and serves the HTML
# body as application/xml. no-cache makes browsers and proxies revalidate, so
# older responses with a wrong type or view are not reused.
<IfModule mod_mime.c>
  <FilesMatch "^sitemap-(index|[0-9]+)\.html$">
    ForceType text/html
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^sitemap-(index|[0-9]+)\.(xml|html)$">
    Header append Vary Accept
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sitemap-(index|[0-9]+)\.html$">
    Header always set Content-Type "text/html; charset=utf-8"
  </FilesMatch>
</IfModule>

RewriteEngine On

# The former entry point /sitemap.xml now points to the sitemap index.
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

RewriteCond %{HTTP:Accept} text/html [NC]
RewriteRule ^(sitemap-(?:index|[0-9]+))\.xml$ $1.html [L]

RewriteRule ^api/contact/?$ api/contact.php [L]
