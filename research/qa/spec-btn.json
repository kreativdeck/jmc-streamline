{
 "selectors": {
  "heroButton": "#brxe-zcacuh",
  "processButton": "#brxe-1d78d8",
  "ctaPhoneButton": ".k-cta-alpha__buttons span.btn--primary",
  "ctaMailButton": ".k-cta-alpha__buttons span.btn--outline",
  "featureButton": "#brxe-lqwtqp",
  "footerNavLink": ".k-footer-center__nav-link",
  "footerCopyright": ".fr-legal-meta-alpha__copyright",
  "blogCardTitle": ".fr-article-card-foxtrot__title",
  "blogCardLede": ".fr-article-card-foxtrot__lede",
  "blogCardDate": ".fr-article-card-foxtrot__date",
  "grid29Heading": ".grid-29-card__heading",
  "grid29Card": ".grid-29-card",
  "accentBadge": ".k-accent-heading",
  "bodyText": ".intro__subheading",
  "processStep": ".fr-process-card-charlie__step",
  "processHeading": ".fr-process-card-charlie__heading",
  "quoteText": ".k-blockquote__text"
 },
 "props": [
  "background-color",
  "color",
  "border-color",
  "border-width",
  "border-style",
  "border-radius",
  "padding",
  "font-size",
  "font-family",
  "font-weight",
  "letter-spacing",
  "line-height",
  "text-transform",
  "gap",
  "row-gap",
  "width",
  "height",
  "min-height",
  "max-width",
  "aspect-ratio",
  "opacity",
  "box-shadow",
  "text-align"
 ],
 "localSelectors": {
  "heroButton": "main > section:nth-of-type(1) a",
  "processButton": "main > section:nth-of-type(4) a",
  "ctaPhoneButton": "main > section:nth-of-type(9) span:has(> a[href^=\"tel:\"])",
  "ctaMailButton": "main > section:nth-of-type(9) span:has(> a[href^=\"mailto:\"])",
  "featureButton": "main > section:nth-of-type(5) a",
  "footerNavLink": "#site-footer nav ul a",
  "footerCopyright": "#site-footer p",
  "blogCardTitle": "main > section:nth-of-type(8) li h3",
  "blogCardLede": "main > section:nth-of-type(8) li p",
  "blogCardDate": "main > section:nth-of-type(8) li time",
  "grid29Heading": "main > section:nth-of-type(2) li h3",
  "grid29Card": "main > section:nth-of-type(2) ul > li",
  "accentBadge": "main > section:nth-of-type(2) > div > div > span",
  "bodyText": "main > section:nth-of-type(2) > div > div > p",
  "processStep": "main > section:nth-of-type(4) ol li > div > span",
  "processHeading": "main > section:nth-of-type(4) ol li h3",
  "quoteText": "main blockquote"
 }
}
