  "heroAccent": "#brxe-pmwlmx",
  "heroLede": ".k-hero-frontpage__lede",
  "heroSection": "#brxe-db8925",
  "heroContent": "#brxe-cultgk",
  "body": "body",
  "container": ".k-hero-frontpage__content-wrapper",
  "headerSection": "#brxe-micxis",
  "logo": ".k-header-logo--white",
  "menuToggle": ".bricks-mobile-menu-toggle",
  "langLink": ".lang-item a",
  "processButton": "#brxe-1d78d8",
  "ctaPhoneButton": ".k-cta-alpha__buttons .btn--primary",
  "accentBadge": ".k-accent-heading",
  "quoteText": ".k-blockquote__text",
  "blogCardTitle": ".fr-article-card-foxtrot__title",
  "blogCard": ".fr-article-card-foxtrot",
  "grid29Card": ".grid-29-card"
 },
 "props": [
  "background-color",
  "color",
  "border-color",
  "border-width",
  "border-style",
  "border-radius",
  "padding",
  "font-size",
  "font-family",
  "font-weight",
  "letter-spacing",
  "line-height",
  "text-transform",
  "gap",
  "row-gap",
  "width",
  "height",
  "min-height",
  "max-width",
  "aspect-ratio",
  "opacity"
 ],
 "localSelectors": {
  "heroButton": "main > section:nth-of-type(1) a",
  "heroHeading": "main > section:nth-of-type(1) h1",
  "heroAccent": "main > section:nth-of-type(1) span",
  "heroLede": "main > section:nth-of-type(1) p",
  "heroSection": "main > section:nth-of-type(1)",
  "heroContent": "main > section:nth-of-type(1) > div:last-child > div",
  "body": "body",
  "container": "main > section:nth-of-type(1) > div:last-child",
  "headerSection": "[data-site-header] > div",
  "logo": "[data-site-header] img",
  "menuToggle": "[data-menu-toggle]",
  "langLink": "[data-site-header] a[hreflang]",
  "processButton": "main > section:nth-of-type(4) a",
  "ctaPhoneButton": "main > section:nth-of-type(9) span:has(> a[href^=\"tel:\"])",
  "accentBadge": "main > section:nth-of-type(2) > div > div > span",
  "quoteText": "main blockquote",
  "blogCardTitle": "main > section:nth-of-type(8) li h3",
  "blogCard": "main > section:nth-of-type(8) ul > li",
  "grid29Card": "main > section:nth-of-type(2) ul > li"
 }
}
